require "cgi"
require "shellwords"

default_platform :ios

def env!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing required environment variable: #{name}") if value.empty?
  value
end

def env_or(name, fallback)
  value = ENV[name].to_s.strip
  value.empty? ? fallback : value
end

def xml_escape(value)
  CGI.escapeHTML(value.to_s)
end

platform :ios do

  before_all do
    setup_circle_ci if ENV["CI"] || ENV["CIRCLECI"]
  end

  private_lane :asc_api_key do
    options = {
      key_id: env!("API_KEY_ID"),
      issuer_id: env!("API_ISSUER_ID")
    }

    if ENV["API_KEY_CONTENT"].to_s.strip.empty?
      options[:key_filepath] = env!("API_KEY_FILEPATH")
    else
      options[:key_content] = env!("API_KEY_CONTENT")
      options[:is_key_content_base64] = ENV["API_KEY_CONTENT_BASE64"].to_s.downcase == "true"
    end

    app_store_connect_api_key(**options)
  end

  private_lane :ensure_flutter_ready do
    sh("flutter --version")
    sh("flutter pub get")
    sh("bundle exec pod install --project-directory=ios") if File.exist?("ios/Podfile")
  end

  private_lane :export_options_plist do
    configured_path = ENV["EXPORT_OPTIONS_PLIST"].to_s.strip
    next configured_path unless configured_path.empty?

    bundle_id = env!("BASE_BUNDLE")
    team_id = env!("TEAM_ID")
    profile_name = env_or("APPSTORE_PROFILE_NAME", "#{env_or("MAIN_TARGET", "Runner")}-App")
    path = File.expand_path("ExportOptions.plist", __dir__)

    File.write(path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>destination</key>
        <string>export</string>
        <key>manageAppVersionAndBuildNumber</key>
        <false/>
        <key>method</key>
        <string>app-store-connect</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{xml_escape(bundle_id)}</key>
          <string>#{xml_escape(profile_name)}</string>
        </dict>
        <key>signingCertificate</key>
        <string>Apple Distribution</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>stripSwiftSymbols</key>
        <true/>
        <key>teamID</key>
        <string>#{xml_escape(team_id)}</string>
        <key>uploadSymbols</key>
        <true/>
      </dict>
      </plist>
    PLIST

    path
  end

  private_lane :latest_ipa_path do
    configured_path = ENV["IPA_PATH"].to_s.strip
    next configured_path unless configured_path.empty?

    ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].max_by { |path| File.mtime(path) }
    UI.user_error!("No IPA found in build/ios/ipa. Run `bundle exec fastlane ios build` first.") unless ipa
    ipa
  end

  desc "Build Flutter iOS IPA for App Store Connect"
  lane :build do
    ensure_flutter_ready

    args = [
      "flutter",
      "build",
      "ipa",
      "--release",
      "--export-options-plist=#{export_options_plist}"
    ]

    app_version = ENV["APPSTORE_APP_VER"].to_s.strip
    build_number = env_or("APPSTORE_BUILD_NUMBER", ENV["CIRCLE_BUILD_NUM"].to_s.strip)

    args << "--build-name=#{app_version}" unless app_version.empty?
    args << "--build-number=#{build_number}" unless build_number.empty?

    sh(args.shelljoin)
  end

  desc "Fetch or create App Store certificates and provisioning profiles"
  lane :manage_provision do
    match(
      api_key: asc_api_key,
      git_url: env!("MATCH_GIT_URL"),
      git_branch: env_or("MATCH_GIT_BRANCH", "appstore"),
      git_full_name: env_or("MATCH_GIT_FULL_NAME", "Behichev"),
      git_user_email: env_or("MATCH_GIT_USER_EMAIL", "ivanbehichev@gmail.com"),
      type: "appstore",
      app_identifier: env!("BASE_BUNDLE"),
      profile_name: env_or("APPSTORE_PROFILE_NAME", "#{env_or("MAIN_TARGET", "Runner")}-App"),
      output_path: "fastlane/provision",
      readonly: false
    )
  end

  desc "Update Runner team ID and provisioning profile"
  lane :update_project do
    bundle_id = env!("BASE_BUNDLE")
    main_target = env_or("MAIN_TARGET", "Runner")
    project_path = env_or("XCODE_PROJ", "ios/Runner.xcodeproj")
    profile_name = env_or("APPSTORE_PROFILE_NAME", "#{main_target}-App")
    profile_path = env_or("APPSTORE_PROFILE_PATH", "fastlane/provision/AppStore_#{bundle_id}.mobileprovision")

    update_project_team(
      path: project_path,
      targets: main_target,
      teamid: env!("TEAM_ID")
    )

    update_project_provisioning(
      xcodeproj: project_path,
      profile: profile_path,
      target_filter: "^#{Regexp.escape(main_target)}$"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      targets: [main_target],
      build_configurations: ["Release"],
      team_id: env!("TEAM_ID"),
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )
  end

  desc "Upload the generated Flutter IPA to App Store Connect / TestFlight"
  lane :upload_build do
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: env!("BASE_BUNDLE"),
      ipa: latest_ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Alias for uploading an already generated Flutter IPA"
  lane :submit_build do
    upload_build
  end

  desc "Build, sign, and upload the Flutter iOS app to App Store Connect"
  lane :appstore_submit do
    manage_provision
    update_project
    build
    upload_build
  end

end
